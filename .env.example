# ==============================================================================
# E-CCB EA SÚP — MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG (.env.example)
# Hệ sinh thái Ea Súp Số — ccb.easupso.com
# ==============================================================================
# HƯỚNG DẪN BẢO MẬT CHUẨN BITWARDEN:
# 1. Sao chép file này thành .env: `cp .env.example .env`
# 2. Sinh mật khẩu ngẫu nhiên tối thiểu 32 ký tự (chữ hoa, chữ thường, số, ký tự đặc biệt)
#    bằng Bitwarden Generator cho DB_PASSWORD và JWT_SECRET.
# 3. TUYỆT ĐỐI KHÔNG commit file .env chứa thông tin thật lên Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Nội bộ Docker Network - internal_net)
# ------------------------------------------------------------------------------
# Tên đăng nhập cơ sở dữ liệu
DB_USER=eccb_admin

# Mật khẩu mạnh sinh từ Bitwarden (VD: a9Z#8dK!1mQx$2vLp*7sBw@0yT)
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_BITWARDEN_32_CHARS_MIN

# Tên cơ sở dữ liệu
DB_NAME=eccb_db

# Cổng nội bộ container postgres (mặc định 5432, không expose ra ngoài VPS)
DB_PORT=5432

# URL kết nối cơ sở dữ liệu dành cho Prisma ORM (kết nối trực tiếp qua service name 'db')
# Cấu trúc: postgresql://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}?schema=public
DATABASE_URL="postgresql://eccb_admin:CHANGE_ME_GENERATE_WITH_BITWARDEN_32_CHARS_MIN@db:5432/eccb_db?schema=public"

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (AUTHENTICATION & JWT)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT Token (Sinh ngẫu nhiên chuỗi Hex hoặc Base64 64 ký tự từ Bitwarden)
JWT_SECRET=CHANGE_ME_GENERATE_JWT_SECRET_WITH_BITWARDEN_MIN_64_CHARS

# Thời gian sống của JWT Token (VD: 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH ĐỊA CHỈ & WEBAPP (APPLICATION URL)
# ------------------------------------------------------------------------------
# Tên miền chính thức của hệ thống trong Hệ sinh thái Ea Súp Số
SITE_URL=https://ccb.easupso.com

# Môi trường chạy (development | production | test)
NODE_ENV=production

# Cổng lắng nghe nội bộ của ứng dụng Next.js (mặc định 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN HỆ THỐNG & MẬT KHẨU KHỞI TẠO (ADMIN & MEMBER DEFAULT CREDENTIALS)
# ------------------------------------------------------------------------------
ADMIN_EMAILS="lehanhkt01@gmail.com,trunghieuktkt@gmail.com"
ADMIN_DEFAULT_PASSWORD="12345678@"
MEMBER_DEFAULT_PASSWORD="12345678@"
